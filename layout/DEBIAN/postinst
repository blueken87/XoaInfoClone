#!/bin/sh

chown 0:0 /var/jb/Applications/XoaInfo.app/XoaInfo
chmod 755 /var/jb/Applications/XoaInfo.app/XoaInfo
chmod +s /var/jb/Applications/XoaInfo.app/XoaInfo

chown 0:0 /var/jb/usr/libexec/XoaInfoD
chmod 755 /var/jb/usr/libexec/XoaInfoD
chmod +s /var/jb/usr/libexec/XoaInfoD

chown root:wheel /var/jb/Library/LaunchDaemons/com.ienthach.XoaInfoD.plist
launchctl load -w /var/jb/Library/LaunchDaemons/com.ienthach.XoaInfoD.plist  >/dev/null 2>&1

CFG=/var/mobile/Library/Preferences/com.ienthach.XoaInfoConfig.plist
if ! test -f "$CFG"; then
	echo "không có file cấu hình"
	cp /var/jb/Applications/XoaInfo.app/com.ienthach.XoaInfo.json "$CFG"
fi
chown mobile:mobile "$CFG" 2>/dev/null

PLUTIL=/usr/bin/plutil
[ -x "$PLUTIL" ] || PLUTIL=plutil
for kv in \
	"optionOldIDFA:YES" \
	"optionOldIDFASource:YES" \
	"customIDFAServer:cdn.jsdelivr.net/gh/blueken87/XoaInfoClone@main" \
	"customURLOldIDFA:https://cdn.jsdelivr.net/gh/blueken87/XoaInfoClone@main" \
	"UserNameOldIDFA:a" \
	"PassOldIDFA:a" \
	"expDate:2099-12-31 23:59:59" \
	"phase:9" \
	"RetenData:99999" \
	"DeleteListData:" \
	"DataRun:" \
	"RunVersion:1" ; do
	key=${kv%%:*}
	val=${kv#*:}
	$PLUTIL -replace "$key" -string "$val" "$CFG" 2>/dev/null || $PLUTIL -insert "$key" -string "$val" "$CFG" 2>/dev/null
done
killall -9 lsd
